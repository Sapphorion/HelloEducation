rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Assignment submission files. Path encodes the owning student directly
    // so writes can be checked without a cross-product lookup; reads for the
    // assigning tutor/admin cross-reference the Firestore assignment doc.
    match /assignment-submissions/{studentId}/{assignmentId}/{fileName} {
      function assignmentDoc() {
        return firestore.get(/databases/(default)/documents/assignments/$(assignmentId));
      }
      function isAdmin() {
        return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
      }

      allow read: if request.auth != null && (
        request.auth.uid == studentId
        || assignmentDoc().data.createdBy == request.auth.uid
        || isAdmin()
      );
      allow write: if request.auth != null
        && request.auth.uid == studentId
        && request.resource.size < 10 * 1024 * 1024;
    }

    // Same pattern as assignment-submissions above, for the matric re-write
    // programme's separate matricAssignments collection.
    match /matric-assignment-submissions/{studentId}/{assignmentId}/{fileName} {
      function matricAssignmentDoc() {
        return firestore.get(/databases/(default)/documents/matricAssignments/$(assignmentId));
      }
      function isAdmin() {
        return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
      }

      allow read: if request.auth != null && (
        request.auth.uid == studentId
        || matricAssignmentDoc().data.createdBy == request.auth.uid
        || isAdmin()
      );
      allow write: if request.auth != null
        && request.auth.uid == studentId
        && request.resource.size < 10 * 1024 * 1024;
    }

    // Study resource attachments (worksheets, PDFs, etc.) a tutor/admin
    // uploads to share with student(s). Read is left open to any signed-in
    // user rather than cross-referenced per student: the actual "who can
    // see this" gate is the studyResources/matricStudyResources Firestore
    // doc (whether the app ever hands a given user this file's download
    // URL at all) — and getDownloadURL() tokens bypass Storage read rules
    // for anyone holding the link anyway, same as the submission files
    // above, so a stricter rule here wouldn't add real protection.
    match /study-resources/{uid}/{fileName} {
      function isTutorOrAdmin() {
        let role = firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role;
        return role == 'tutor' || role == 'admin';
      }

      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && isTutorOrAdmin()
        && request.resource.size < 10 * 1024 * 1024;
    }
  }
}