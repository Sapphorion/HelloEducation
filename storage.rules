rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Assignment submission files. Path encodes the owning student directly
    // so writes can be checked without a cross-product lookup; reads for the
    // assigning tutor/admin cross-reference the Firestore assignment doc.
    match /assignment-submissions/{studentId}/{assignmentId}/{fileName} {
      function assignmentDoc() {
        return firestore.get(/databases/(default)/documents/assignments/$(assignmentId));
      }
      function isAdmin() {
        return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
      }

      allow read: if request.auth != null && (
        request.auth.uid == studentId
        || assignmentDoc().data.createdBy == request.auth.uid
        || isAdmin()
      );
      allow write: if request.auth != null
        && request.auth.uid == studentId
        && request.resource.size < 10 * 1024 * 1024;
    }

    // Same pattern as assignment-submissions above, for the matric re-write
    // programme's separate matricAssignments collection.
    match /matric-assignment-submissions/{studentId}/{assignmentId}/{fileName} {
      function matricAssignmentDoc() {
        return firestore.get(/databases/(default)/documents/matricAssignments/$(assignmentId));
      }
      function isAdmin() {
        return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
      }

      allow read: if request.auth != null && (
        request.auth.uid == studentId
        || matricAssignmentDoc().data.createdBy == request.auth.uid
        || isAdmin()
      );
      allow write: if request.auth != null
        && request.auth.uid == studentId
        && request.resource.size < 10 * 1024 * 1024;
    }

    // Study resource / assignment attachments (worksheets, PDFs, etc.) a
    // tutor/admin uploads to share with student(s). Deliberately does NOT
    // cross-reference Firestore for a role check here (unlike the read
    // rules above) — cross-service Storage->Firestore rule calls need a
    // one-time permission grant that's normally triggered by opening the
    // Storage Rules page in the Firebase console after such a deploy; a
    // CLI-only deploy can silently leave that unset, which makes any rule
    // depending on it fail every request rather than degrade gracefully.
    // Scoping write to the caller's own uid folder plus a size cap is
    // enough here: an arbitrary signed-in user writing to their own
    // uid-scoped folder can't do anything with it — the file only becomes
    // visible to anyone once a studyResources/matricAssignments Firestore
    // doc references it, and creating those docs is already gated by
    // Firestore's own rules (tutor/admin only).
    match /study-resources/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024;
    }
  }
}