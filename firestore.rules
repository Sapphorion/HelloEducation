rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userRole(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.role;
    }

    function isAdmin(userId) {
      return signedIn() && userRole(userId) == 'admin';
    }

    function isTutor(userId) {
      return signedIn() && userRole(userId) == 'tutor';
    }

    function isStudent(userId) {
      return signedIn() && userRole(userId) == 'student';
    }

    function isMatricStudent(userId) {
      return signedIn() && userRole(userId) == 'matricStudent';
    }

    // True if the signed-in user is a parent account linked to studentId via
    // its own childUids array. Only admins can set childUids (see the users
    // update rule below), so this link can't be self-granted.
    function isParentOf(studentId) {
      return signedIn()
        && studentId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('childUids', []);
    }

    match /users/{userId} {
      // Tutors need this to look up a student by email when logging a
      // session, assigning work, or sharing a resource — those forms query
      // this collection by email/role from the client, which Firestore can
      // only allow if the rule holds without a per-document lookup.
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin(request.auth.uid) || isTutor(request.auth.uid));
      // Self-serve signup may only claim the student role. Tutor, parent and
      // admin roles must be granted by an existing admin (via the admin
      // dashboard or directly in the Firestore console) — never self-assigned.
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'student';
      // Self-updates may never change role or childUids (parent-child links)
      // — only an admin can grant a role or link a parent to a student.
      allow update: if signedIn() && (
        isAdmin(request.auth.uid)
        || (request.auth.uid == userId
            && request.resource.data.role == resource.data.role
            && request.resource.data.get('childUids', []) == resource.data.get('childUids', []))
      );
      allow delete: if isAdmin(request.auth.uid);
    }

    match /tutors/{tutorId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin(request.auth.uid);
    }

    match /students/{studentId} {
      allow read: if signedIn() && (request.auth.uid == studentId || isAdmin(request.auth.uid) || isParentOf(studentId));
      allow create, update: if signedIn() && (request.auth.uid == studentId || isAdmin(request.auth.uid));
      allow delete: if isAdmin(request.auth.uid);
    }

    // Tutor-set recurring weekly windows (e.g. "Monday 3-6pm"). Purely
    // informational for students deciding when to request a session — the
    // real conflict check happens server-side in the requestSession function.
    match /availability/{availabilityId} {
      allow read: if signedIn();
      allow create: if signedIn() && (
        isAdmin(request.auth.uid)
        || (isTutor(request.auth.uid) && request.resource.data.tutorId == request.auth.uid)
      );
      allow update, delete: if signedIn() && (isAdmin(request.auth.uid) || resource.data.tutorId == request.auth.uid);
    }

    match /sessions/{sessionId} {
      allow read: if signedIn() && (
        isAdmin(request.auth.uid)
        || resource.data.tutorId == request.auth.uid
        || resource.data.studentId == request.auth.uid
        || isParentOf(resource.data.studentId)
      );
      // Student-requested sessions (status "pending") are created by the
      // requestSession Cloud Function via the Admin SDK, which bypasses
      // these rules and does the real conflict check — so no client-side
      // student create path is needed here.
      allow create: if signedIn() && (
        isAdmin(request.auth.uid)
        || (isTutor(request.auth.uid) && request.resource.data.tutorId == request.auth.uid)
      );
      allow update: if signedIn() && (
        isAdmin(request.auth.uid)
        || resource.data.tutorId == request.auth.uid
        // A student may only withdraw their own still-pending request.
        || (resource.data.studentId == request.auth.uid
            && resource.data.status == 'pending'
            && request.resource.data.status == 'cancelled')
      );
      allow delete: if isAdmin(request.auth.uid) || resource.data.tutorId == request.auth.uid;
    }

    // Tutor/admin assigns work to a student; the student submits a text note
    // and/or a file (the file itself lives in Cloud Storage — see
    // storage.rules — this doc just carries its download URL once uploaded).
    match /assignments/{assignmentId} {
      allow read: if signedIn() && (
        resource.data.studentId == request.auth.uid
        || resource.data.createdBy == request.auth.uid
        || isAdmin(request.auth.uid)
        || isParentOf(resource.data.studentId)
      );
      allow create: if signedIn() && (
        isAdmin(request.auth.uid)
        || (isTutor(request.auth.uid) && request.resource.data.createdBy == request.auth.uid)
      );
      allow update: if signedIn() && (
        isAdmin(request.auth.uid)
        || resource.data.createdBy == request.auth.uid
        || resource.data.studentId == request.auth.uid
      );
      allow delete: if isAdmin(request.auth.uid) || resource.data.createdBy == request.auth.uid;
    }

    // Study resources (links) tutor/admin shares with a specific student.
    match /studyResources/{resourceId} {
      allow read: if signedIn() && (
        resource.data.studentId == request.auth.uid
        || resource.data.createdBy == request.auth.uid
        || isAdmin(request.auth.uid)
        || isParentOf(resource.data.studentId)
      );
      allow create: if signedIn() && (
        isAdmin(request.auth.uid)
        || (isTutor(request.auth.uid) && request.resource.data.createdBy == request.auth.uid)
      );
      allow update: if signedIn() && (isAdmin(request.auth.uid) || resource.data.createdBy == request.auth.uid);
      allow delete: if isAdmin(request.auth.uid) || resource.data.createdBy == request.auth.uid;
    }

    // A student asks a specific tutor a question; the tutor (or admin)
    // replies. Single-reply, not a full thread — kept simple on purpose.
    match /questions/{questionId} {
      allow read: if signedIn() && (
        resource.data.studentId == request.auth.uid
        || resource.data.tutorId == request.auth.uid
        || isAdmin(request.auth.uid)
        || isParentOf(resource.data.studentId)
      );
      allow create: if signedIn() && isStudent(request.auth.uid) && request.resource.data.studentId == request.auth.uid;
      allow update: if signedIn() && (resource.data.tutorId == request.auth.uid || isAdmin(request.auth.uid));
      allow delete: if isAdmin(request.auth.uid) || resource.data.studentId == request.auth.uid;
    }

    // Matric re-write programme: a fully separate, fixed-timetable cohort
    // (matricStudent role) from general tutoring. Profile doc mirrors
    // students/{uid} but is admin-managed only — no self-serve create.
    match /matricStudents/{studentId} {
      // Tutors need this to look up a Second Chance student by email when
      // sharing a resource with them from the tutor dashboard.
      allow read: if signedIn() && (request.auth.uid == studentId || isAdmin(request.auth.uid) || isTutor(request.auth.uid));
      allow write: if isAdmin(request.auth.uid);
    }

    // Admin-editable controlled list of NSC subject names, used to populate
    // the subject picker when creating class slots / enrolling students.
    match /matricSubjects/{subjectId} {
      allow read: if signedIn();
      allow write: if isAdmin(request.auth.uid);
    }

    // A fixed weekly class slot (subject/day/time/tutor, capacity 4). Rosters
    // are filled by the enrollMatricStudent Cloud Function via the Admin SDK
    // (bypasses these rules) so the "find an open slot" search and the
    // capacity check stay server-side — no client create/update path needed
    // beyond admin managing slots directly.
    match /matricGroups/{groupId} {
      allow read: if signedIn() && (
        isAdmin(request.auth.uid)
        || resource.data.tutorId == request.auth.uid
        || request.auth.uid in resource.data.studentIds
      );
      allow create, update, delete: if isAdmin(request.auth.uid);
    }

    // Materials attached to one specific dated occurrence of a recurring
    // matricGroups class slot (identified by groupId + date). tutorId and
    // studentIds are copied from the group at creation time so reads don't
    // need a cross-document get() — same denormalization matricGroups itself
    // already uses.
    match /matricSessionMaterials/{materialId} {
      allow read: if signedIn() && (
        isAdmin(request.auth.uid)
        || resource.data.tutorId == request.auth.uid
        || request.auth.uid in resource.data.studentIds
      );
      allow create: if signedIn() && (
        isAdmin(request.auth.uid)
        || (isTutor(request.auth.uid) && request.resource.data.tutorId == request.auth.uid)
      );
      allow delete: if isAdmin(request.auth.uid) || resource.data.createdBy == request.auth.uid;
    }

    // Tasks/assessments for the matric re-write programme. Same shape as
    // assignments/{assignmentId} above, kept as a separate collection since
    // matric students are a separate role.
    match /matricAssignments/{assignmentId} {
      allow read: if signedIn() && (
        resource.data.studentId == request.auth.uid
        || resource.data.createdBy == request.auth.uid
        || isAdmin(request.auth.uid)
      );
      allow create: if signedIn() && (
        isAdmin(request.auth.uid)
        || (isTutor(request.auth.uid) && request.resource.data.createdBy == request.auth.uid)
      );
      allow update: if signedIn() && (
        isAdmin(request.auth.uid)
        || resource.data.createdBy == request.auth.uid
        || resource.data.studentId == request.auth.uid
      );
      allow delete: if isAdmin(request.auth.uid) || resource.data.createdBy == request.auth.uid;
    }

    // A Second Chance student asks a specific tutor a question; same shape
    // as questions/{questionId} above, kept as a separate collection since
    // matric students are a separate role. Ownership-checked rather than
    // role-gated on create, matching matricAssignments above.
    match /matricQuestions/{questionId} {
      allow read: if signedIn() && (
        resource.data.studentId == request.auth.uid
        || resource.data.tutorId == request.auth.uid
        || isAdmin(request.auth.uid)
      );
      allow create: if signedIn() && request.resource.data.studentId == request.auth.uid;
      allow update: if signedIn() && (resource.data.tutorId == request.auth.uid || isAdmin(request.auth.uid));
      allow delete: if isAdmin(request.auth.uid) || resource.data.studentId == request.auth.uid;
    }

    // Study resources for the Second Chance programme. Same shape as
    // studyResources/{resourceId} above, kept separate for the same reason.
    match /matricStudyResources/{resourceId} {
      allow read: if signedIn() && (
        resource.data.studentId == request.auth.uid
        || resource.data.createdBy == request.auth.uid
        || isAdmin(request.auth.uid)
      );
      allow create: if signedIn() && (
        isAdmin(request.auth.uid)
        || (isTutor(request.auth.uid) && request.resource.data.createdBy == request.auth.uid)
      );
      allow update: if signedIn() && (isAdmin(request.auth.uid) || resource.data.createdBy == request.auth.uid);
      allow delete: if isAdmin(request.auth.uid) || resource.data.createdBy == request.auth.uid;
    }

    // AI homework-helper chat transcript. Written only by the askAI Cloud
    // Function via the Admin SDK (bypasses these rules) — no client write
    // path, since the transcript must stay paired with the rate-limit check.
    // Keyed by uid only (not role), so this already covers Second Chance
    // students using the same shared chatbot — no change needed here.
    match /aiConversations/{studentId}/messages/{messageId} {
      allow read: if signedIn() && (request.auth.uid == studentId || isAdmin(request.auth.uid));
    }

    // Per-student daily message counter for the AI homework helper. Same
    // Admin-SDK-only write pattern as above.
    match /aiUsage/{studentId} {
      allow read: if signedIn() && (request.auth.uid == studentId || isAdmin(request.auth.uid));
    }

    // AI-generated (or tutor-authored) worksheets/slideshows. Read is
    // broadly signed-in rather than per-student, since a material is shared
    // by pasting its viewer link into an existing study-resource/session
    // material entry — there's no reverse index of who it was shared with,
    // and the content itself isn't sensitive (same tradeoff as tutors/
    // matricSubjects being broadly readable).
    match /materials/{materialId} {
      allow read: if signedIn();
      allow create: if signedIn() && (
        isAdmin(request.auth.uid)
        || (isTutor(request.auth.uid) && request.resource.data.createdBy == request.auth.uid)
      );
      allow update, delete: if isAdmin(request.auth.uid) || resource.data.createdBy == request.auth.uid;
    }

    match /dashboardData/{docId} {
      allow read: if signedIn() && (isAdmin(request.auth.uid) || isStudent(request.auth.uid) || isTutor(request.auth.uid));
      allow write: if isAdmin(request.auth.uid);
    }

    match /tutorDashboardData/{docId} {
      allow read: if signedIn() && (isAdmin(request.auth.uid) || isTutor(request.auth.uid));
      allow write: if isAdmin(request.auth.uid);
    }
  }
}
