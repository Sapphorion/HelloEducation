rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userRole(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.role;
    }

    function isAdmin(userId) {
      return signedIn() && userRole(userId) == 'admin';
    }

    function isTutor(userId) {
      return signedIn() && userRole(userId) == 'tutor';
    }

    function isStudent(userId) {
      return signedIn() && userRole(userId) == 'student';
    }

    // True if the signed-in user is a parent account linked to studentId via
    // its own childUids array. Only admins can set childUids (see the users
    // update rule below), so this link can't be self-granted.
    function isParentOf(studentId) {
      return signedIn()
        && studentId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('childUids', []);
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin(request.auth.uid));
      // Self-serve signup may only claim the student role. Tutor, parent and
      // admin roles must be granted by an existing admin (via the admin
      // dashboard or directly in the Firestore console) — never self-assigned.
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'student';
      // Self-updates may never change role or childUids (parent-child links)
      // — only an admin can grant a role or link a parent to a student.
      allow update: if signedIn() && (
        isAdmin(request.auth.uid)
        || (request.auth.uid == userId
            && request.resource.data.role == resource.data.role
            && request.resource.data.get('childUids', []) == resource.data.get('childUids', []))
      );
      allow delete: if isAdmin(request.auth.uid);
    }

    match /tutors/{tutorId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin(request.auth.uid);
    }

    match /students/{studentId} {
      allow read: if signedIn() && (request.auth.uid == studentId || isAdmin(request.auth.uid) || isParentOf(studentId));
      allow create, update: if signedIn() && (request.auth.uid == studentId || isAdmin(request.auth.uid));
      allow delete: if isAdmin(request.auth.uid);
    }

    match /sessions/{sessionId} {
      allow read: if signedIn() && (
        isAdmin(request.auth.uid)
        || resource.data.tutorId == request.auth.uid
        || resource.data.studentId == request.auth.uid
        || isParentOf(resource.data.studentId)
      );
      allow create: if signedIn() && (
        isAdmin(request.auth.uid)
        || (isTutor(request.auth.uid) && request.resource.data.tutorId == request.auth.uid)
      );
      allow update: if signedIn() && (
        isAdmin(request.auth.uid) || resource.data.tutorId == request.auth.uid
      );
      allow delete: if isAdmin(request.auth.uid) || resource.data.tutorId == request.auth.uid;
    }

    match /dashboardData/{docId} {
      allow read: if signedIn() && (isAdmin(request.auth.uid) || isStudent(request.auth.uid) || isTutor(request.auth.uid));
      allow write: if isAdmin(request.auth.uid);
    }

    match /tutorDashboardData/{docId} {
      allow read: if signedIn() && (isAdmin(request.auth.uid) || isTutor(request.auth.uid));
      allow write: if isAdmin(request.auth.uid);
    }

    match /bookings/{bookingId} {
      allow read: if signedIn() && (isAdmin(request.auth.uid)
        || resource.data.studentId == request.auth.uid
        || resource.data.tutorId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.studentId == request.auth.uid;
      allow update: if signedIn() && (isAdmin(request.auth.uid)
        || request.resource.data.studentId == request.auth.uid
        || request.resource.data.tutorId == request.auth.uid);
      allow delete: if isAdmin(request.auth.uid);
    }
  }
}
